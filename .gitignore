# Never commit secrets. The old function file has a Supercell API key written
# into it -- keep it out of git entirely (delete it once that key is revoked).
netlify/functions/*.txt
.env
.env.*

# Local-only folders: Netlify CLI state, test copies, design previews.
.netlify/
_probe/
_previews/

# Design-tool working files (Impeccable) -- local only.
.impeccable/

# GitHub Pages build output (scripts/build-pages.py) -- made fresh on every push.
_pages/
